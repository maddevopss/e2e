{
  "name": "madsuite-e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "guard:gitignore": "node scripts/guard-gitignore-policy.js",
    "guard:hygiene": "node scripts/guard-repo-hygiene.js",
    "guard:accounting-closure": "node scripts/guard-accounting-closure-contract.js",
    "guard:payroll-closure": "node scripts/guard-payroll-closure-contract.js",
    "guard:cognitive-mad-foundations-closure": "node scripts/guard-cognitive-mad-foundations-closure-contract.js",
    "test": "playwright test",
    "test:contracts": "node ../node_modules/jest/bin/jest.js --config jest.config.js",
    "test:public": "node scripts/run-public-tests.js",
    "test:auth": "playwright test tests/auth-ui.setup.js",
    "test:authenticated": "npm run test:auth && cross-env E2E_AUTH_REQUIRED=1 E2E_AUTH_FILE=storageState/auth.json playwright test tests/authenticated-session.spec.js tests/responsive-mobile.spec.js",
    "test:auth-smoke": "npm run test:auth && cross-env E2E_AUTH_REQUIRED=1 E2E_AUTH_FILE=storageState/auth.json playwright test tests/authenticated-session.spec.js",
    "test:responsive": "playwright test tests/responsive-mobile.spec.js",
    "test:critical": "playwright test tests/critical-flow.spec.js",
    "test:critical:external": "cross-env E2E_EXTERNAL_SERVERS=1 playwright test tests/critical-flow.spec.js",
    "test:critical:full": "npm run test:critical -- --reporter=html,list",
    "test:accounting-closure": "playwright test tests/accounting-closure.spec.js --workers=1",
    "test:accounting-remediation": "playwright test tests/accounting-remediation.spec.js --workers=1",
    "test:accounting-reversal": "playwright test tests/accounting-controlled-reversal.spec.js --workers=1",
    "test:accounting-period-lock": "playwright test tests/accounting-period-lock.spec.js --workers=1",
    "test:payroll-closure": "playwright test tests/payroll-closure.spec.js --workers=1",
    "test:cognitive-mad-foundations-closure": "playwright test tests/cognitive-mad-foundations-closure.spec.js --workers=1",
    "check:e2e": "npm run guard:gitignore && npm run guard:hygiene && npm run guard:accounting-closure && npm run guard:payroll-closure && npm run guard:cognitive-mad-foundations-closure && npm run test:public",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.0"
  }
}
